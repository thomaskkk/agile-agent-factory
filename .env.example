# Jira Cloud Integration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=your-email@provider.com
JIRA_API_KEY=your_api_token_here
JIRA_PROJECT_KEY=PROJ
JIRA_HUMAN_ACCOUNT_ID=account_id_to_mention
JIRA_FLAG_FIELD_ID=customfield_10021
JIRA_FLAG_VALUE=Impediment

# Aider CLI Code Generation (optional — requires `aider` on PATH)
# Install: pip install aider-chat
AIDER_ENABLED=false
AIDER_MODEL=anthropic/claude-sonnet-4-6

# Per-agent model overrides — provider auto-detected from name prefix:
#   claude-* → Anthropic,  gpt-*/o1-*/o3-*/o4-* → OpenAI
# Leave blank to use the global ANTHROPIC_MODEL / OPENAI_MODEL for that provider.
# Balance: Sonnet for quality-critical steps, Haiku for structured/simple outputs.
PO_MODEL=claude-sonnet-4-6              # Requirements → epics/stories; wrong output cascades
QA_MODEL=claude-haiku-4-5-20251001      # Gherkin criteria; constrained structured output
UX_MODEL=claude-haiku-4-5-20251001      # UX spec JSON; enum-validated, constrained
TL_MODEL=claude-sonnet-4-6              # Architecture blueprint; quality is load-bearing for dev
DEV_MODEL=claude-sonnet-4-6             # Code generation; quality drives test pass rate
TEST_MODEL=claude-sonnet-4-6            # Pytest correction; has traceback context, but simpler models fail easily
REVIEWER_MODEL=claude-sonnet-4-6        # DoD audit; false approvals are expensive
README_MODEL=claude-haiku-4-5-20251001  # README writing; lowest quality risk

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-5.4
# Which provider to try first. The other becomes the fallback.
# Options: anthropic | openai
LLM_PRIMARY_PROVIDER=anthropic

# LangSmith tracing (LangGraph reads LANGCHAIN_* vars)
# Note: LANGSMITH_API_KEY is an alias — prefer LANGCHAIN_API_KEY below
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=agile-agent-factory
# Large architecture/code-generation calls can need 120–180s; raise if you see
# repeated timeouts at exactly this value.
LLM_TIMEOUT_SECONDS=120
# Max output tokens per LLM call. Raise if multi-file generations/corrections
# get truncated (symptom: "JSON parse failed" on a response that starts valid).
LLM_MAX_TOKENS=16384
# Transient rate-limit handling: back off and retry the whole provider chain
# this many times (exponential backoff) before pausing the pipeline.
LLM_QUOTA_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=30

# Factory Settings
MAX_RETRIES_DEV=2
MAX_REVIEW_RETRIES=2
MAX_CORRECTION_FAILURES=2
DRY_RUN=true
UV_BIN=uv

# Kanban WIP Limits per Column (Phase 3+ parallelism)
WIP_LIMIT_REFINEMENT=3
WIP_LIMIT_TECH_DESIGN=2
WIP_LIMIT_DEVELOPMENT=2
WIP_LIMIT_TESTING=2
WIP_LIMIT_CODE_REVIEW=1
